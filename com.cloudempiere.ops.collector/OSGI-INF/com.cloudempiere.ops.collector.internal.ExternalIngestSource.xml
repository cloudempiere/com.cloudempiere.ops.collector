<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.4.0"
      name="com.cloudempiere.ops.collector.internal.ExternalIngestSource"
      immediate="true">
   <implementation class="com.cloudempiere.ops.collector.internal.ExternalIngestSource"/>
   <service>
      <provide interface="org.osgi.service.event.EventHandler"/>
   </service>
   <property name="event.topics" type="String" value="com/cloudempiere/ops/ingest"/>
   <reference name="dispatcher"
         interface="com.cloudempiere.ops.collector.internal.EventDispatcher"
         cardinality="1..1"
         policy="static"
         field="dispatcher"/>
</scr:component>
