<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.4.0"
      name="com.cloudempiere.ops.collector.internal.EventDispatcher"
      immediate="true"
      activate="activate">
   <implementation class="com.cloudempiere.ops.collector.internal.EventDispatcher"/>
   <service>
      <provide interface="com.cloudempiere.ops.collector.internal.EventDispatcher"/>
   </service>
   <reference name="severityClassifier"
         interface="com.cloudempiere.ops.collector.internal.SeverityClassifier"
         cardinality="1..1"
         policy="static"
         field="severityClassifier"/>
   <reference name="tenantEnricher"
         interface="com.cloudempiere.ops.collector.internal.TenantEnricher"
         cardinality="1..1"
         policy="static"
         field="tenantEnricher"/>
</scr:component>
