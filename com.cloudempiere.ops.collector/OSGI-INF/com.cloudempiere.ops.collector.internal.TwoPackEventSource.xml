<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.4.0"
      configuration-policy="optional"
      name="com.cloudempiere.ops.collector.internal.TwoPackEventSource">
   <implementation class="com.cloudempiere.ops.collector.internal.TwoPackEventSource"/>
   <reference name="IEventManager"
         interface="org.adempiere.base.event.IEventManager"
         cardinality="1..1"
         policy="static"
         bind="bindEventManager"
         unbind="unbindEventManager"/>
   <reference name="EventDispatcher"
         interface="com.cloudempiere.ops.collector.internal.EventDispatcher"
         cardinality="1..1"
         policy="static"
         bind="bindEventDispatcher"
         unbind="unbindEventDispatcher"/>
</scr:component>
