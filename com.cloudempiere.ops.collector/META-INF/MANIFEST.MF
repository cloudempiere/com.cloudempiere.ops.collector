Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: CloudEmpiere Operational Observability Collector
Bundle-SymbolicName: com.cloudempiere.ops.collector;singleton:=true
Bundle-Version: 14.0.0.qualifier
Bundle-Vendor: CloudEmpiere
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: com.cloudempiere.ops.collector
Eclipse-RegisterBuddy: org.adempiere.base
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=11))"
Require-Bundle: org.adempiere.base;bundle-version="[14.0.0,15.0.0)",
 org.eclipse.osgi;bundle-version="[3.17.0,4.0.0)"
Import-Package: org.osgi.framework;version="[1.10,2)",
 org.osgi.framework.wiring;version="[1.2,2)",
 org.osgi.service.component.annotations;version="[1.3,2)",
 org.osgi.service.condition;version="[1.0.0,2.0.0)",
 javax.servlet;version="3.1.0",
 javax.servlet.http;version="3.1.0",
 javax.sql,
 org.osgi.service.component.runtime;version="[1.3,2)",
 org.osgi.service.component.runtime.dto;version="[1.3,2)",
 org.osgi.service.event;version="[1.4,2)",
 org.osgi.service.log;version="[1.4,2)";resolution:=optional,
 org.compiere.model,
 io.github.classgraph;version="4.8.138",
 io.opentelemetry.api.trace;version="[1.40,2)",
 org.apache.logging.log4j;version="[2.20,3)";resolution:=optional
Web-ContextPath: ops
Jetty-Environment: ee8
Service-Component: OSGI-INF/*.xml
Bundle-ActivationPolicy: lazy
Export-Package: com.cloudempiere.ops.collector.api;version="1.0.0"
