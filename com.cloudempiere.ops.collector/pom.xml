<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>com.cloudempiere.ops.collector</artifactId>
  <packaging>eclipse-plugin</packaging>
  <parent>
    <groupId>com.cloudempiere</groupId>
    <artifactId>com.cloudempiere.ops.collector.parent</artifactId>
    <version>14.0.0-SNAPSHOT</version>
    <relativePath>../com.cloudempiere.ops.collector.parent/pom.xml</relativePath>
  </parent>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <build>
    <plugins>
      <!-- Generate OSGi DS descriptors (OSGI-INF/*.xml) from R7 @Component annotations.
           ADR-001 §4.4: DS annotations only, no BundleActivator. -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-ds-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <dsVersion>1.4</dsVersion>
          <path>OSGI-INF</path>
        </configuration>
        <executions>
          <execution>
            <id>generate-ds-components</id>
            <goals>
              <goal>declarative-services</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
