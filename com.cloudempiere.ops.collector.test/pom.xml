<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.cloudempiere</groupId>
  <artifactId>com.cloudempiere.ops.collector.test</artifactId>
  <version>14.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!--
    Standalone JUnit 5 unit tests for the pure-logic classes (no OSGi/iDempiere runtime).
    NOT part of the Tycho reactor (JUnit 5 isn't in the iDempiere P2). Depends on the built
    bundle jar, so install the parent pom + reactor first, then run (verified 16/16 green):
      mvn -f com.cloudempiere.ops.collector.parent/pom.xml install -N
      mvn install -Pcloudempiere-local -DskipTests
      mvn -f com.cloudempiere.ops.collector.test/pom.xml test -Dmaven.repo.local=~/.m2/repository-idempiere-10
    OSGi integration tests (Pax Exam: broken bundle -> assert events) are a separate effort
    per ADR-001 §4.15.
  -->

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.cloudempiere</groupId>
      <artifactId>com.cloudempiere.ops.collector</artifactId>
      <version>14.0.0-SNAPSHOT</version>
      <scope>test</scope>
      <!--
        The collector imports io.opentelemetry.api.trace, so its Tycho-flattened POM carries a
        compile-scope dependency on the ops.lib.opentelemetry bundle with type=eclipse-plugin.
        Plain (non-Tycho) Maven cannot map the eclipse-plugin type to the installed .jar, so it
        would fail resolution / fall back to the S3 p2 repo. These unit tests exercise only the
        pure-logic classes (SeverityClassifier, PoolStatsShim.Stats) which never touch OTel, so we
        exclude the OTel bundle from the test classpath.
      -->
      <exclusions>
        <exclusion>
          <groupId>com.cloudempiere</groupId>
          <artifactId>com.cloudempiere.ops.lib.opentelemetry</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
