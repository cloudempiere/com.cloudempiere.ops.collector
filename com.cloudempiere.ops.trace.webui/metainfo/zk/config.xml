<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZK LIBRARY config (ADR-001 §11.1), discovered by ZK on the org.adempiere.ui.zk host
  classpath (this bundle is a fragment of it).

  IMPORTANT: a classpath-discovered metainfo/zk/config.xml uses ZK's *library-config*
  schema — root <config> with a REQUIRED <config-name> — NOT the <zk> root of
  WEB-INF/zk.xml. Using <zk> here makes ZK throw
  "IllegalSyntaxException: <config-name> is required" on every webui boot, which cascades
  to "DeviceNotFoundException: ajax not found" and takes the whole webui down (CLD-1912).
  Registers the two trace enrichers as ZK listeners (ExecutionInit + EventInterceptor).
-->
<config>
   <config-name>com.cloudempiere.ops.trace.webui</config-name>
   <listener>
      <listener-class>com.cloudempiere.ops.trace.webui.WebuiSpanEnricher</listener-class>
   </listener>
   <listener>
      <listener-class>com.cloudempiere.ops.trace.webui.WebuiEventEnricher</listener-class>
   </listener>
</config>
