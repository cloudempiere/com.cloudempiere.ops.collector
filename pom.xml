<?xml version="1.0" encoding="UTF-8"?>
<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>com.cloudempiere.ops.collector.main</artifactId>
	<packaging>pom</packaging>
	<parent>
		<groupId>com.cloudempiere</groupId>
		<artifactId>com.cloudempiere.ops.collector.parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>com.cloudempiere.ops.collector.parent/pom.xml</relativePath>
	</parent>
	<modules>
		<!-- Build order: lib -> bundles -> features -> p2 (P2 must be LAST). -->
		<module>com.cloudempiere.ops.lib.opentelemetry</module>
		<module>com.cloudempiere.ops.collector</module>
		<module>com.cloudempiere.ops.trace.webui</module>
		<module>com.cloudempiere.ops.rest</module>
		<module>com.cloudempiere.ops.collector.feature</module>
		<module>com.cloudempiere.ops.trace.webui.feature</module>
		<module>com.cloudempiere.ops.rest.feature</module>
		<module>com.cloudempiere.ops.collector.p2</module>
		<!-- Plain-Maven (packaging=jar) unit tests for the pure-logic classes. Unlike the Tycho
		     test fragments elsewhere in CLDE these need no OSGi runtime and no database, so they
		     RUN here rather than merely compiling. Kept out of the reactor previously with the
		     note "JUnit 5 isn't in the iDempiere P2" — which is not the reason it works: this
		     module takes JUnit from Maven Central, not from P2. -->
		<module>com.cloudempiere.ops.collector.test</module>
	</modules>
</project>
